    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "ioredis": "^5.3.2",
    "pg": "^8.16.0",
    "pino": "^8.19.0",
    "pino-http": "^8.0.0",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^14.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
